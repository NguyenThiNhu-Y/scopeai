# Template env cho backend — KHÔNG điền giá trị key thật vào đây (BR-06).
# Sao chép sang .env / .env.preview và điền qua Cài đặt dự án của VibeFlow.
# Backend tự đọc file .env này (nếu có) — env vars thật vẫn ưu tiên hơn.
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_VERIFY_SSL=true
LLM_CA_BUNDLE=
# Redacted by VibeFlow for security reasons: the secret value on the line below was replaced before it reached the AI model, so this file does NOT contain the real value. Put the real value back by hand if this file needs it.
DATABASE_URL=[REDACTED:env-database_url]
APP_ENV=development
LOG_LEVEL=INFO
LLM_MAX_RETRIES=2
